{
  "github": {
    "silent": true
  },
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "crons": [
    {
      "path": "/api/residential-charge",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/residential-jobs",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/gift-reconcile",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/recruiting-mail",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/communication-budget",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/integration-deliver",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/owner-sms",
      "schedule": "* * * * *"
    }
  ],
  "functions": {
    "api/owner-voice.js": {
      "maxDuration": 60,
      "includeFiles": "docs/alice-operation-policy.txt"
    },
    "api/admin-map.js": {
      "maxDuration": 60
    },
    "api/residential-charge.js": {
      "maxDuration": 300
    },
    "api/residential-booking.js": {
      "maxDuration": 60
    },
    "api/agent-referrals.js": {
      "maxDuration": 60,
      "includeFiles": "assets/agent-referral-template.png"
    },
    "api/residential-jobs.js": {
      "maxDuration": 300
    },
    "api/contractor-review.js": {
      "maxDuration": 300
    },
    "api/gift-cards.js": {
      "maxDuration": 60,
      "includeFiles": "assets/gift-card-template.pdf"
    },
    "api/residential-webhook.js": {
      "maxDuration": 60,
      "includeFiles": "assets/gift-card-template.pdf"
    },
    "api/gift-reconcile.js": {
      "maxDuration": 300,
      "includeFiles": "assets/gift-card-template.pdf"
    },
    "api/customer-portal.js": {
      "maxDuration": 60
    },
    "api/crm-sales.js": {
      "maxDuration": 60
    },
    "api/recruiting-mail.js": {
      "maxDuration": 300
    },
    "api/applicants.js": {
      "maxDuration": 60
    },
    "api/ba-onboarding.js": {
      "maxDuration": 60,
      "includeFiles": "assets/irs-w9.pdf"
    },
    "api/communication-budget.js": {
      "maxDuration": 300
    },
    "api/ba-share.js": {
      "maxDuration": 30,
      "includeFiles": "assets/ba-social-template.png"
    },
    "api/integration-deliver.js": {
      "maxDuration": 300
    },
    "api/turnly-mcp.js": {
      "maxDuration": 300
    },
    "api/integration-v2.js": {
      "maxDuration": 300
    },
    "api/owner-sms.js": {
      "maxDuration": 300,
      "includeFiles": "docs/alice-operation-policy.txt"
    },
    "api/alice-mcp.js": {
      "maxDuration": 300
    },
    "api/alice-voice.js": {
      "maxDuration": 120,
      "includeFiles": "docs/alice-operation-policy.txt"
    },
    "api/alice-check.js": {
      "maxDuration": 300,
      "includeFiles": "docs/alice-operation-policy.txt"
    }
  },
  "routes": [
    {
      "src": "^/\\.well-known/oauth-authorization-server$",
      "dest": "/api/turnly-oauth?action=metadata"
    },
    {
      "src": "^/\\.well-known/oauth-protected-resource(?:/api/turnly-mcp)?$",
      "dest": "/api/turnly-oauth?action=resource"
    },
    {
      "src": "^/oauth-authorize\\.(html|mjs)$",
      "headers": {
        "Cache-Control": "no-store",
        "Referrer-Policy": "no-referrer",
        "X-Frame-Options": "DENY",
        "Content-Security-Policy": "frame-ancestors 'none'"
      },
      "continue": true
    },
    {
      "src": "^/apply(?:\\.html)?/?$",
      "dest": "/api/apply-redirect"
    },
    {
      "src": "^/(?:index\\.html)?$",
      "has": [
        {
          "type": "host",
          "value": "client.turnlypros.com"
        }
      ],
      "dest": "/customer.html"
    },
    {
      "src": "^/(?:customer|residential-referral|gift-cards|gift-card-terms|crm-unsubscribe)\\.html$",
      "has": [
        {
          "type": "host",
          "value": "portal.turnlypros.com"
        }
      ],
      "headers": {
        "Cache-Control": "no-store",
        "Referrer-Policy": "no-referrer"
      },
      "dest": "/client-redirect.html"
    },
    {
      "src": "^/(?:index\\.html)?$",
      "has": [
        {
          "type": "host",
          "value": "ba.turnlypros.com"
        }
      ],
      "dest": "/ba-login.html"
    },
    {
      "src": "^/r/(BA-[A-Z0-9]{16})$",
      "has": [
        {
          "type": "host",
          "value": "ba.turnlypros.com"
        }
      ],
      "status": 307,
      "headers": {
        "Location": "https://client.turnlypros.com/residential-referral.html?ba=$1"
      }
    },
    {
      "src": "^/(?:index\\.html)?$",
      "has": [
        {
          "type": "host",
          "value": "sales.turnlypros.com"
        }
      ],
      "dest": "/sales-login.html"
    },
    {
      "src": "^/qa-analytics(?:\\.html)?/?$",
      "status": 308,
      "headers": {
        "Location": "/qa-queue.html"
      }
    },
    {
      "src": "^/r/([A-Za-z0-9_-]{22})$",
      "dest": "/api/agent-link?slug=$1"
    },
    {
      "src": "^/service-worker\\.js$",
      "has": [
        {
          "type": "host",
          "value": "res.turnlypros.com"
        }
      ],
      "headers": {
        "Cache-Control": "no-store"
      },
      "dest": "/residential-domain-worker.js"
    },
    {
      "src": "^/(?:index\\.html)?$",
      "has": [
        {
          "type": "host",
          "value": "res.turnlypros.com"
        }
      ],
      "dest": "https://turnlypros.com/residential/index.html"
    },
    {
      "src": "^/(.*)$",
      "has": [
        {
          "type": "host",
          "value": "res.turnlypros.com"
        }
      ],
      "dest": "https://turnlypros.com/residential/$1"
    },
    {
      "src": "^/service-worker\\.js$",
      "has": [
        {
          "type": "host",
          "value": "residental.turnlypros.com"
        }
      ],
      "headers": {
        "Cache-Control": "no-store"
      },
      "dest": "/residential-domain-worker.js"
    },
    {
      "src": "^/(?:index\\.html)?$",
      "has": [
        {
          "type": "host",
          "value": "residental.turnlypros.com"
        }
      ],
      "dest": "https://turnlypros.com/residential/index.html"
    },
    {
      "src": "^/(.*)$",
      "has": [
        {
          "type": "host",
          "value": "residental.turnlypros.com"
        }
      ],
      "dest": "https://turnlypros.com/residential/$1"
    },
    {
      "handle": "filesystem"
    }
  ]
}
