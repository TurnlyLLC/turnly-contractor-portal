{
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "crons": [{ "path": "/api/residential-charge", "schedule": "0 * * * *" }],
  "functions": {
    "api/residential-charge.js": { "maxDuration": 300 },
    "api/residential-booking.js": { "maxDuration": 60 },
    "api/agent-referrals.js": {
      "maxDuration": 60,
      "includeFiles": "assets/agent-referral-template.png"
    }
  },
  "routes": [
    {
      "src": "^/service-worker\\.js$",
      "has": [
        {
          "type": "host",
          "value": "residental.turnlypros.com"
        }
      ],
      "headers": {
        "Cache-Control": "no-store"
      },
      "dest": "/residential-domain-worker.js"
    },
    {
      "src": "^/(?:index\\.html)?$",
      "has": [
        {
          "type": "host",
          "value": "residental.turnlypros.com"
        }
      ],
      "dest": "https://turnlypros.com/residential/index.html"
    },
    {
      "src": "^/(.*)$",
      "has": [
        {
          "type": "host",
          "value": "residental.turnlypros.com"
        }
      ],
      "dest": "https://turnlypros.com/residential/$1"
    },
    {
      "handle": "filesystem"
    }
  ]
}
