{
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/service-worker.js",
      "has": [{ "type": "host", "value": "residental.turnlypros.com" }],
      "destination": "/residential-domain-worker.js"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "residental.turnlypros.com" }],
      "destination": "https://turnlypros.com/residential/index.html"
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "residental.turnlypros.com" }],
      "destination": "https://turnlypros.com/residential/:path*"
    }
  ]
}
