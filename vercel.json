{
  "github": {
    "silent": true
  },
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "crons": [
    {
      "path": "/api/residential-charge",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/residential-jobs",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/gift-reconcile",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/recruiting-mail",
      "schedule": "*/10 * * * *"
    }
  ],
  "functions": {
    "api/residential-charge.js": {
      "maxDuration": 300
    },
    "api/residential-booking.js": {
      "maxDuration": 60
    },
    "api/agent-referrals.js": {
      "maxDuration": 60,
      "includeFiles": "assets/agent-referral-template.png"
    },
    "api/residential-jobs.js": {
      "maxDuration": 300
    },
    "api/contractor-review.js": {
      "maxDuration": 300
    },
    "api/gift-cards.js": {
      "maxDuration": 60,
      "includeFiles": "assets/gift-card-template.pdf"
    },
    "api/residential-webhook.js": {
      "maxDuration": 60,
      "includeFiles": "assets/gift-card-template.pdf"
    },
    "api/gift-reconcile.js": {
      "maxDuration": 300,
      "includeFiles": "assets/gift-card-template.pdf"
    },
    "api/customer-portal.js": {
      "maxDuration": 60
    },
    "api/crm-sales.js": {
      "maxDuration": 60
    },
    "api/recruiting-mail.js": {
      "maxDuration": 300
    },
    "api/applicants.js": {
      "maxDuration": 60
    },
    "api/ba-onboarding.js": {
      "maxDuration": 60,
      "includeFiles": "assets/irs-w9.pdf"
    }
  },
  "routes": [
    {
      "src": "^/(?:index\\.html)?$",
      "has": [
        {
          "type": "host",
          "value": "ba.turnlypros.com"
        }
      ],
      "dest": "/ba-login.html"
    },
    {
      "src": "^/r/(BA-[A-Z0-9]{16})$",
      "has": [
        {
          "type": "host",
          "value": "ba.turnlypros.com"
        }
      ],
      "dest": "/ba-referral.html?code=$1"
    },
    {
      "src": "^/(?:index\\.html)?$",
      "has": [
        {
          "type": "host",
          "value": "sales.turnlypros.com"
        }
      ],
      "dest": "/sales-login.html"
    },
    {
      "src": "^/qa-analytics(?:\\.html)?/?$",
      "status": 308,
      "headers": {
        "Location": "/qa-queue.html"
      }
    },
    {
      "src": "^/r/([A-Za-z0-9_-]{22})$",
      "dest": "/api/agent-link?slug=$1"
    },
    {
      "src": "^/service-worker\\.js$",
      "has": [
        {
          "type": "host",
          "value": "res.turnlypros.com"
        }
      ],
      "headers": {
        "Cache-Control": "no-store"
      },
      "dest": "/residential-domain-worker.js"
    },
    {
      "src": "^/(?:index\\.html)?$",
      "has": [
        {
          "type": "host",
          "value": "res.turnlypros.com"
        }
      ],
      "dest": "https://turnlypros.com/residential/index.html"
    },
    {
      "src": "^/(.*)$",
      "has": [
        {
          "type": "host",
          "value": "res.turnlypros.com"
        }
      ],
      "dest": "https://turnlypros.com/residential/$1"
    },
    {
      "src": "^/service-worker\\.js$",
      "has": [
        {
          "type": "host",
          "value": "residental.turnlypros.com"
        }
      ],
      "headers": {
        "Cache-Control": "no-store"
      },
      "dest": "/residential-domain-worker.js"
    },
    {
      "src": "^/(?:index\\.html)?$",
      "has": [
        {
          "type": "host",
          "value": "residental.turnlypros.com"
        }
      ],
      "dest": "https://turnlypros.com/residential/index.html"
    },
    {
      "src": "^/(.*)$",
      "has": [
        {
          "type": "host",
          "value": "residental.turnlypros.com"
        }
      ],
      "dest": "https://turnlypros.com/residential/$1"
    },
    {
      "handle": "filesystem"
    }
  ]
}
