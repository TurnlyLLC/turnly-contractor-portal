{
  "name": "Turnly Admin PWA",
  "short_name": "Turnly Admin",
  "description": "Mobile admin portal for Turnly scheduling, assignments, contractors, messages, and QA video review.",
  "id": "/admin-pwa/",
  "start_url": "/admin-pwa/",
  "scope": "/admin-pwa/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#07111f",
  "theme_color": "#07111f",
  "categories": ["business", "productivity"],
  "icons": [
    {
      "src": "/icons/turnly-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/turnly-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/turnly-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Schedule",
      "short_name": "Schedule",
      "description": "Open the admin schedule.",
      "url": "/admin-pwa/schedule.html"
    },
    {
      "name": "Assignments",
      "short_name": "Jobs",
      "description": "Open assignment management.",
      "url": "/admin-pwa/assignments.html"
    },
    {
      "name": "Messages",
      "short_name": "Messages",
      "description": "Open Turnly messages.",
      "url": "/admin-pwa/messages.html"
    }
  ]
}
