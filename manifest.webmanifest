{
  "name": "Turnly Pro",
  "short_name": "Turnly Pro",
  "description": "Field-ready contractor portal for Turnly assignments, schedules, messages, documents, payments, and QA videos.",
  "id": "/contractor.html",
  "start_url": "/contractor.html",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "portrait-primary",
  "background_color": "#F5F5F2",
  "theme_color": "#16233B",
  "categories": [
    "business",
    "productivity"
  ],
  "icons": [
    {
      "src": "/icons/turnly-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/turnly-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/turnly-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "My Jobs",
      "short_name": "Jobs",
      "description": "Open claimed and assigned jobs.",
      "url": "/contractor-my-assignments.html"
    },
    {
      "name": "Schedule",
      "short_name": "Schedule",
      "description": "Open the weekly contractor schedule.",
      "url": "/contractor-schedule.html"
    },
    {
      "name": "Messages",
      "short_name": "Messages",
      "description": "Open Turnly job conversations.",
      "url": "/contractor-messages.html"
    },
    {
      "name": "Job Board",
      "short_name": "Board",
      "description": "Open available Turnly jobs.",
      "url": "/contractor-available.html"
    }
  ]
}
